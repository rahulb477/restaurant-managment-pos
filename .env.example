# Nest / Next
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:1995
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orderrestro
UPLOADS_DIR=./uploads

# Dual-mode backends (defaults preserve current Postgres + JWT)
# Production (Vercel) uses Firebase only — do not set DATABASE_URL there.
AUTH_PROVIDER=firebase
DATA_STORE=firestore
FIRESTORE_DOMAINS=

# Firebase Admin SDK (server only — never NEXT_PUBLIC)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web config (identifies the project; not authorization)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Same value as NEXT_PUBLIC_FIREBASE_API_KEY; used server-side for Identity Toolkit login
FIREBASE_WEB_API_KEY=

# ImgBB (server only — never NEXT_PUBLIC)
IMGBB_API_KEY=
